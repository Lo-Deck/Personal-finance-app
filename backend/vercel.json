{
  "version": 2,
  "builds": [
    {
      "src": "app.js",
      "use": "@vercel/node"
    },
    {
      "src": "../frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/styles/(.*)",
      "dest": "../frontend/styles/$1"
    },
    {
      "src": "/scripts/(.*)",
      "dest": "../frontend/scripts/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "../frontend/assets/$1"
    },
    {
      "src": "/pages/(.*)",
      "dest": "../frontend/pages/$1"
    },
    {
      "src": "/(.*)",
      "dest": "app.js"
    }
  ]
}
