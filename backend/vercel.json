{
  "version": 2,
  "builds": [
    {
      "src": "app.js",
      "use": "@vercel/node"
    },
    {
      "src": "../frontend/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(styles|scripts|assets|pages)/(.*)",
      "dest": "../frontend/$1/$2"
    },
    {
      "src": "/(.*)",
      "dest": "app.js"
    }
  ]
}
